# =========================================================================
# LUMEN RESEARCH PLATFORM - CONFIGURATION
# =========================================================================

# Database & Cache
DATABASE_URL=postgresql+asyncpg://research:research@postgres:5432/research
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-in-production

# Object Storage (MinIO / S3)
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=research-papers
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=miniosecret

# =========================================================================
# AI / LLM INFERENCE ENGINE CONFIGURATION (OPTIONAL)
# =========================================================================
# You can set system-wide keys here, OR enter your key directly in the web
# interface using the "⚡ AI Key: Setup Gemini" button in the top navbar.

# Google Gemini (Recommended - Free Tier available with generous rate limits)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
